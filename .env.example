# Recorded example requires no credentials. This file is documentation only;
# export these values into your shell (or load them with your environment tool).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Live provider calls are unavailable unless this explicit opt-in is enabled.
MTH_ENABLE_LIVE_AI=0
# Optional; without this value, each browser session uses isolated in-memory data.
# Set a path for durable local history across app restarts.
# MTH_DB_PATH=/absolute/path/to/workflow.sqlite3
